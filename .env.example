# Handled — keys for the build and the demo. Never committed (.gitignore).
# Fill in what you have; leave the rest blank. Tests never read this file.

# Google AI Studio. Needed first: P1 records the vision cassettes with it.
GEMINI_API_KEY=

# Texts. Photon (sponsor) first; Twilio is the fallback; blank = the fake sender.
# Photon: app.beta.photon.codes -> Settings -> Project ID; API keys -> New API key
# with project:read + project:write. The key is shown once.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
# The shared iMessage number Photon assigns to your phone (iMessage page -> Add
# your number -> Assign from the shared pool). You must text it once from your
# iPhone before the agent can message you: a shared line never sends first.
PHOTON_AGENT_HANDLE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Your phone, where the texts land (E.164, e.g. +13105551234).
HANDLED_PHONE=

# Optional: Browser Use Cloud, only if their sponsor prize wants the cloud.
BROWSER_USE_API_KEY=

# Demo switches (the build sets these; leave as is).
HANDLED_SITES=fixtures
HANDLED_RECORD=0
